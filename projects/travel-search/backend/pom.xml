<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.8</version>
    <relativePath/>
  </parent>
  <groupId>dev.esweb</groupId>
  <artifactId>travel-search</artifactId>
  <version>0.7.0</version>
  <properties>
    <java.version>25</java.version>
    <elasticsearch-client.version>9.4.8</elasticsearch-client.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>co.elastic.clients</groupId>
      <artifactId>elasticsearch-java</artifactId>
      <version>${elasticsearch-client.version}</version>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource>
        <directory>../data/f22</directory>
        <targetPath>f22</targetPath>
        <includes><include>evaluation.json</include></includes>
      </resource>
      <resource>
        <directory>../data/f25</directory>
        <targetPath>f25</targetPath>
        <includes><include>stay-table.json</include></includes>
      </resource>
      <resource>
        <directory>../data/f26</directory>
        <targetPath>f26</targetPath>
        <includes><include>stay-table.json</include></includes>
      </resource>
      <resource>
        <directory>../data/f27</directory>
        <targetPath>f27</targetPath>
        <includes><include>stay-table.json</include></includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
