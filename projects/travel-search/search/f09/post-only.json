{
  "size": 20,
  "track_total_hits": true,
  "_source": {
    "includes": [
      "attraction_id",
      "name",
      "city_code",
      "ticket_price_fen",
      "currency",
      "status",
      "themes"
    ]
  },
  "query": {
    "bool": {
      "must": [
        {
          "multi_match": {
            "query": "西湖",
            "fields": [
              "name^3",
              "aliases^2",
              "description"
            ],
            "type": "best_fields",
            "operator": "and",
            "tie_breaker": 0.0
          }
        }
      ],
      "filter": [
        {
          "term": {
            "currency": {
              "value": "CNY"
            }
          }
        },
        {
          "range": {
            "ticket_price_fen": {
              "gte": 0,
              "lte": 20000
            }
          }
        },
        {
          "term": {
            "status": {
              "value": "open"
            }
          }
        }
      ]
    }
  },
  "post_filter": {
    "bool": {
      "filter": [
        {
          "terms": {
            "city_code": [
              "HZ"
            ]
          }
        },
        {
          "terms": {
            "themes": [
              "lake",
              "culture"
            ]
          }
        }
      ]
    }
  },
  "aggregations": {
    "cities": {
      "terms": {
        "field": "city_code",
        "size": 10,
        "shard_size": 10,
        "show_term_doc_count_error": true,
        "order": [
          {
            "_count": "desc"
          },
          {
            "_key": "asc"
          }
        ]
      }
    },
    "themes": {
      "terms": {
        "field": "themes",
        "size": 10,
        "shard_size": 10,
        "show_term_doc_count_error": true,
        "order": [
          {
            "_count": "desc"
          },
          {
            "_key": "asc"
          }
        ]
      }
    }
  },
  "sort": [
    {
      "attraction_id": {
        "order": "asc"
      }
    }
  ]
}
