{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "-1",
    "analysis": {
      "analyzer": {
        "travel_text": {
          "type": "custom",
          "char_filter": [
            "html_strip"
          ],
          "tokenizer": "standard",
          "filter": [
            "lowercase"
          ]
        },
        "case_sensitive": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": []
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "attraction_id": {
        "type": "keyword"
      },
      "name": {
        "type": "text",
        "analyzer": "travel_text",
        "search_analyzer": "travel_text",
        "fields": {
          "mismatch": {
            "type": "text",
            "analyzer": "travel_text",
            "search_analyzer": "keyword"
          },
          "raw": {
            "type": "keyword"
          }
        }
      },
      "city_code": {
        "type": "keyword"
      },
      "status": {
        "type": "keyword"
      },
      "currency": {
        "type": "keyword"
      },
      "ticket_price_fen": {
        "type": "integer",
        "coerce": false
      }
    }
  }
}
