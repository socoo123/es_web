{
  "size": 20,
  "track_total_hits": true,
  "explain": true,
  "query": {
    "bool": {
      "filter": [
        {"term": {"status": {"value": "open"}}},
        {"term": {"currency": {"value": "CNY"}}},
        {"range": {"ticket_price_fen": {"gte": 0, "lte": 10000}}},
        {"term": {"city_code": {"value": "HZ"}}}
      ],
      "must": [
        {
          "multi_match": {
            "query": "西湖博物馆",
            "fields": ["name^1", "description^1"],
            "type": "best_fields",
            "operator": "and",
            "tie_breaker": 0
          }
        }
      ]
    }
  },
  "sort": [{"_score": "desc"}, {"attraction_id": "asc"}]
}
