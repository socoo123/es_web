      "must": [
        {
          "dis_max": {
            "queries": [
              {"match": {"name": {"query": "西湖博物馆", "operator": "and", "boost": 1}}},
              {"match": {"description": {"query": "西湖博物馆", "operator": "and", "boost": 1}}}
