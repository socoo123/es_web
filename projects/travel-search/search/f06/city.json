{
  "size": 20,
  "track_total_hits": true,
  "track_scores": true,
  "_source": [
    "attraction_id",
    "name",
    "city_code",
    "ticket_price_fen",
    "currency",
    "status",
    "location"
  ],
  "query": {
    "bool": {
      "must": [
        {
          "match": {
            "name": {
              "query": "西湖",
              "operator": "or"
            }
          }
        }
      ],
      "filter": [
        {
          "term": {
            "city_code": "HZ"
          }
        },
        {
          "term": {
            "currency": "CNY"
          }
        }
      ]
    }
  },
  "sort": [
    {
      "attraction_id": "asc"
    }
  ]
}
