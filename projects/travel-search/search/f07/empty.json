{
  "size": 20,
  "track_total_hits": true,
  "track_scores": true,
  "_source": {"includes": ["attraction_id", "name", "city_code", "ticket_price_fen", "currency", "status", "location"]},
  "query": {
    "bool": {
      "must": [{"match": {"name": {"query": "火星", "operator": "or"}}}],
