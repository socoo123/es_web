            }
          }
        },
        {
          "term": {
            "hotel_status": {
              "value": "open"
            }
          }
        },
        {
          "nested": {
            "path": "rooms",
            "score_mode": "none",
            "query": {
              "bool": {
                "filter": [
                  {
                    "term": {
                      "rooms.bed_type": {
                        "value": "twin"
                      }
                    }
                  },
                  {
                    "term": {
                      "rooms.meal": {
                        "value": "breakfast"
                      }
                    }
                  },
                  {
                    "term": {
                      "rooms.cancellation": {
                        "value": "flexible"
                      }
                    }
                  },
                  {
                    "term": {
                      "rooms.rate_plan_id": {
                        "value": "bf-flex"
                      }
                    }
                  },
                  {
                    "term": {
                      "rooms.currency": {
                        "value": "CNY"
                      }
                    }
                  },
                  {
                    "term": {
                      "rooms.offer_status": {
                        "value": "active"
                      }
                    }
                  },
                  {
                    "term": {
                      "rooms.service_date": {
                        "value": "2026-11-01"
                      }
                    }
                  },
                  {
                    "range": {
                      "rooms.capacity": {
                        "gte": 2
                      }
                    }
                  },
                  {
                    "range": {
                      "rooms.price_minor": {
                        "gte": 0,
                        "lte": 70000
                      }
