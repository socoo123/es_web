            "inner_hits": {
              "name": "eligible",
              "size": 1,
              "sort": [
                {
                  "rooms.price_minor": {
                    "order": "asc"
                  }
                },
                {
                  "rooms.offer_id": {
                    "order": "asc"
                  }
                }
              ]
            }
          }
        }
      ]
    }
  },
  "sort": [
    {
      "hotel_id": {
        "order": "asc"
      }
    }
  ]
