{
  "size": 20,
  "track_total_hits": true,
  "track_scores": false,
  "_source": {
    "includes": [
      "attraction_id",
      "name",
      "city_code",
      "ticket_price_fen",
      "currency",
      "status",
      "location"
    ]
  },
  "query": {
    "bool": {
      "must": [
        {
          "multi_match": {
            "query": "西湖",
            "fields": [
              "name^3",
              "aliases^2",
              "description"
            ],
            "type": "best_fields",
            "operator": "and",
            "tie_breaker": 0.0
          }
        }
      ],
      "filter": [
        {
          "term": {
            "currency": {
              "value": "CNY"
            }
          }
        },
        {
          "range": {
            "ticket_price_fen": {
              "gte": 0.0,
              "lte": 20000.0
            }
          }
        },
        {
          "term": {
            "status": {
              "value": "open"
            }
          }
        }
      ]
    }
  }
}
