{
  "size": 10,
  "track_total_hits": true,
  "query": {
    "bool": {
      "must": [
        {
          "multi_match": {
            "query": "西湖",
            "fields": [
              "name^3",
              "summary"
            ],
            "operator": "and"
          }
        }
      ],
      "filter": [
        {
          "term": {
            "city_code": "HZ"
          }
        },
        {
          "term": {
            "currency": "CNY"
          }
        },
        {
          "term": {
            "status": "open"
          }
        },
        {
          "range": {
            "ticket_price_fen": {
              "gte": 0,
              "lte": 20000
            }
          }
        },
        {
          "geo_distance": {
            "distance": "3km",
            "location": {
              "lat": 30.25,
              "lon": 120.15
            }
          }
        }
      ]
    }
  },
  "sort": [
    {
      "attraction_id": "asc"
    }
  ]
}
