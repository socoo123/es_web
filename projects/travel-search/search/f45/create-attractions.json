{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 1,
    "refresh_interval": "-1"
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "attraction_id": {
        "type": "keyword"
      },
      "city_code": {
        "type": "keyword"
      },
      "currency": {
        "type": "keyword"
      },
      "status": {
        "type": "keyword"
      },
      "name": {
        "type": "text",
        "analyzer": "whitespace"
      },
      "ticket_price_fen": {
        "type": "long",
        "coerce": false
      },
      "visit_minutes": {
        "type": "integer",
        "coerce": false
      },
      "accessible": {
        "type": "boolean"
      },
      "location": {
        "type": "geo_point"
      },
      "sync_revision": {
        "type": "long"
      },
      "sync_deleted": {
        "type": "boolean"
      },
      "sync_hash": {
        "type": "keyword"
      }
    }
  }
}
