      "ddl": "CREATE TABLE `attraction` (\n  `attraction_id` varchar(3) NOT NULL,\n  `name` varchar(100) NOT NULL,\n  `city_code` varchar(8) NOT NULL,\n  `ticket_price_fen` bigint NOT NULL,\n  `status` varchar(8) NOT NULL,\n  `latitude` double NOT NULL,\n  `longitude` double NOT NULL,\n  PRIMARY KEY (`attraction_id`),\n  CONSTRAINT `attraction_chk_1` CHECK ((`ticket_price_fen` >= 0)),\n  CONSTRAINT `attraction_chk_2` CHECK ((`status` in (_utf8mb4'open',_utf8mb4'closed')))\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci",
