grid-columns: 1
classes: {card: {style: {font-size: 20; border-radius: 10}}}
control: "控制面 · m1 / m2 / m3 三票" {
  grid-columns: 1
  style.font-size: 23
  a: "稳定配置需要至少 2 票\n停 1 个候选：余下 2 票仍可选 master" {class: card}
  b: "停 m1 + m2：只剩 m3 的 1 票\n无 master；默认拒绝写入和元数据变更" {class: card}
}
data: "数据与入口 · 分别观察" {
  grid-columns: 1
  style.font-size: 23
  a: "m3 / d1 都在线：两份景点仍可达\n失去多数时，本课仍从 d1 读到 p01 / p02" {class: card}
  b: "Java 只连接 m1：m1 停机就连不上\n不能据此断言活 d1 的读取也被阻止" {class: card}
  c: "停 m3 + d1：两份业务数据都离线\nm1 / m2 仍有 2 票，但景点搜索失败" {class: card}
}
