grid-columns: 1
classes: {card: {style: {font-size: 20; border-radius: 10}}}
tls: "第一关 · 连接的是谁？" {
  grid-columns: 1
  style.font-size: 23
  a: "Java / curl 信任本课 CA，连接名匹配 SAN\n错误 CA 或错误名字 → TLS 验证失败，没有 HTTP 状态码" {class: card}
}
authn: "第二关 · 请求者是谁？" {
  grid-columns: 1
  style.font-size: 23
  a: "HTTPS 成功后发送 Authorization\n缺失、伪造或已撤销的密钥 → 本课 401" {class: card}
}
authz: "第三关 · 能对哪个资源做什么？" {
  grid-columns: 1
  style.font-size: 23
  a: "reader key：read alias + read → 搜索 200\n同一密钥写文档、访问物理名或管理集群 → 403" {class: card}
  b: "浏览器经 Java 收到安全错误 DTO\nES 的 401 / 403 → Java 502；TLS 连接失败 → Java 503" {class: card}
}
