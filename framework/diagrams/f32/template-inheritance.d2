grid-columns: 1
classes: {card: {style: {font-size: 20; border-radius: 10}}}
choose: "① 先选一个 index template" {
  grid-columns: 1
  style.font-size: 23
  a: "同名模式：priority 200 胜过 100\n低优先级模板的字段不会补进来" {class: card}
  b: "version 是维护者的版本标记\n模拟不创建索引；同优先级重叠会被拒绝" {class: card}
}
compose: "② 再组装选中模板的内容" {
  grid-columns: 1
  style.font-size: 23
  a: "composed_of 按顺序合并组件\n再应用 index template 自身的配置" {class: card}
  b: "本课修复后：2 主 / 每主 1 副\nstrict 字段 + whitespace 名称分析" {class: card}
}
create: "③ 创建时得到独立索引" {
  grid-columns: 1
  style.font-size: 23
  a: "空请求创建 v002：继承当前模板\n显式创建设置优先：v004 改为 3 主 / 0 副" {class: card}
}
later: "④ 修改组件后，只影响后续创建" {
  grid-columns: 1
  style.font-size: 23
  a: "v001 / v002：仍 refresh = -1\nv003：1s，且有新增 source_note 字段" {class: card}
  b: "模板不复制文档，不改变应用入口\n还要读实际 settings / mapping / alias" {class: card}
}
