direction: down
hit: "ES 已命中文档\n高亮不改变候选集合"
encode: "unified ＋ encoder=html\n原文标签先转义"
parse: "Java 仅识别固定 mark 边界\n拆分后解码为文本段"
dto: "DTO：text ＋ matched\n没有片段时回退源文本"
view: "本机卡片创建 mark 或 span\n内容通过 textContent 显示"
hit -> encode: "读取三个原字段"
encode -> parse: "转义文本与受控标记"
parse -> dto: "字段名与结构化片段"
dto -> view: "原文 img / mark 仍是文字"
