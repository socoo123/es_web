direction: down
classes: {card: {style: {font-size: 21; border-radius: 10}}}
symptom: "保留症状与请求\n输入 / ID / 状态码\nerror.type / 客户端起止" {class: card}
window: "同窗口证据\n慢日志 / tasks\nhot threads / 统计差值" {class: card}
cause: "按原因处理\n慢计算：减少工作\n排队：降低并发\n熔断：减少内存需求" {class: card}
recover: "撤销覆盖，再复验\n配置 / 队列 / 计数器\n命中 / 价格 / 必要时回滚" {class: card}
symptom -> window: "X-Opaque-Id\n关联有限类别"
window -> cause: "快照只说明当时活动"
cause -> recover: "一次改变一个条件"
