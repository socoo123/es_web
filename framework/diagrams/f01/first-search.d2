# 箭头只表示本课的手工操作顺序，不表示 ES 内部组件调用。
direction: right
classes: {
  step: {
    width: 155
    height: 100
    style: {
      border-radius: 10
    }
  }
}
create: "1 · 创建索引\nsettings + mappings" {class: step}
write: "2 · 写入景点\n固定 _id" {class: step}
refresh: "3 · 显式刷新\n打开新搜索视图" {class: step}
search: "4 · 按名称搜索\n核对命中 ID" {class: step}
create -> write -> refresh -> search
