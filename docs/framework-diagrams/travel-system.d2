# 规划概念图：箭头表示请求或数据流，不表示整个系统的执行时序。
# 省略认证、报价细节、消息重试与索引重建；PG/MySQL 是独立实验 profile。
direction: right
grid-rows: 2
vertical-gap: 36

requests: "① 业务请求：Java API 决定访问哪种数据" {
  direction: right
  ui: "Vue 门户\n管理后台"
  api: "Java\n业务 API"
  db: "业务数据库\nPG 或 MySQL" {
    shape: cylinder
  }
  es: "Elasticsearch\n搜索投影" {
    shape: cylinder
  }
  ui -> api: "业务参数"
  api -> db: "写入 / 事务\n精确报价"
  api -> es: "受控搜索"
}

sync: "② 搜索投影：数据库提交后，经日志与消息传播" {
  direction: right
  db: "业务数据库\nPG 或 MySQL" {
    shape: cylinder
  }
  cdc: "Debezium\n行变更捕获"
  kafka: "Kafka\n变更消息"
  projection: "Java 消费者\n组装搜索文档"
  es: "Elasticsearch\n搜索投影" {
    shape: cylinder
  }
  db -> cdc: "WAL / binlog"
  cdc -> kafka: "行变更事件"
  kafka -> projection: "消费事件"
  projection -> db: "回查关联数据"
  projection -> es: "完整文档\n删除 / Bulk"
}
