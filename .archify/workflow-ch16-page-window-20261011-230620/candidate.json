  "cards": [
    {
      "dot": "cyan",
      "title": "公式的条件",
      "items": [
        "size>0，无 scroll、rescore、rank、collapse、suggest；sort 时候选携带排序值。",
        "30 篇的本课数据为 12/9/9；size=10 的本地候选上限合计 28，不是固定 30。"
      ]
    },
    {
      "dot": "amber",
      "title": "替代与空结果",
      "items": [
        "size=0 不收集普通 hits；聚合可继续执行。from 超过总命中可过闸但返回空页。",
        "search_after 使用上一页末项 sort 值并保持 from=0；跨请求稳定读者另需 PIT。"
      ]
    }
